# Required-field form shared by booking, existing appointments and reminders.
flow identity
  rate 1.0
  entry begin

state begin
  call crm.identity_start caller_phone=$caller_phone locked_patient_id=$locked_patient_id
  name -> name
  error -> operator reason=identity_failed

state name
  say "{identity_question}"
  listen 20s field=full_name
  dtmf 2 -> use_policy
  dtmf 3 -> use_card
  any -> remember_reply
  timeout 20s -> name
  retry 2 -> operator reason=identity_name_unclear

state use_policy
  call crm.identity_use_policy
  policy -> policy
  error -> operator reason=identity_failed

state use_card
  call crm.identity_use_card
  card -> card
  error -> operator reason=identity_failed

state card
  say "{identity_question}"
  ask card_no digits 3-10 timeout 25s terminator "#"
  listen 25s
  ok -> remember_card
  timeout -> card
  retry 2 -> operator reason=identity_card_unclear

state remember_card
  set identity_reply = $card_no
  goto collect

state birth
  say "{identity_question}"
  ask birth_date digits 8 timeout 25s
  listen 25s
  ok -> remember_birth
  timeout -> birth
  retry 2 -> operator reason=identity_birth_unclear

state phone
  say "{identity_question}"
  ask phone digits 10-15 timeout 25s terminator "#"
  listen 25s
  ok -> remember_phone
  timeout -> phone
  retry 2 -> operator reason=identity_phone_unclear

state policy
  say "{identity_question}"
  ask oms digits 4-16 timeout 25s terminator "#"
  listen 25s
  ok -> remember_policy
  timeout -> policy
  retry 2 -> operator reason=identity_policy_unclear

state readback
  say "{identity_question}"
  listen 20s field=free_text
  dtmf 1 -> yes_reply
  dtmf 0 -> no_reply
  any -> remember_reply
  timeout 20s -> readback
  retry 2 -> operator reason=identity_not_confirmed

state remember_reply
  set identity_reply = $last_utterance
  goto collect

state remember_birth
  set identity_reply = $birth_date
  goto collect

state remember_phone
  set identity_reply = $phone
  goto collect

state remember_policy
  set identity_reply = $oms
  goto collect

state yes_reply
  set identity_reply = "да"
  goto collect

state no_reply
  set identity_reply = "нет"
  goto collect

state collect
  call crm.identity_answer text=$identity_reply
  name -> name
  birth -> birth
  phone -> phone
  policy -> policy
  card -> card
  readback -> readback
  match_confirm -> readback
  policy_confirm -> readback
  ok -> verified
  operator -> operator
  error -> operator reason=identity_failed

state verified
  return

state operator
  say "Передаю обращение сотруднику."
  transfer reason=$reason
  end transfer
